{
  "name": "opencode-zdr-models",
  "version": "1.0.0",
  "description": "OpenCode 2 plugin that keeps only providers' published zero-data-retention (ZDR) models in /models, with a fail-closed snapshot and live policy refresh.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/register-ts.mjs --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chris15joseph/opencode-zdr-models.git"
  },
  "author": "Christopher Joseph <chrisjoseph15496@gmail.com>",
  "homepage": "https://github.com/chris15joseph/opencode-zdr-models#readme",
  "bugs": {
    "url": "https://github.com/chris15joseph/opencode-zdr-models/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "privacy",
    "zero-retention",
    "data-retention",
    "models",
    "zdr",
    "zero-data-retention"
  ],
  "license": "MIT"
}
